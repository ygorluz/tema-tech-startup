---
import BunzoLayout from '../layouts/BunzoLayout.astro';
import Breadcrumb from '../components/bunzo/Breadcrumb.astro';
import { readData } from '../lib/readData';

const siteConfig = readData('siteConfig.json', { name: 'Arte Plural' });
const legalData = readData('terms.json', { title: 'Termos de Uso', content: [] });

const pageTitle = legalData.hero?.title || legalData.title || "Termos de Uso";
const pageDesc = legalData.hero?.desc || legalData.description || `Termos de uso do ${siteConfig.name || 'site'}`;

const rawContent = legalData.content;
const sections = Array.isArray(rawContent) 
  ? rawContent 
  : (Array.isArray(legalData.sections) ? legalData.sections : []);

const htmlContent = !Array.isArray(rawContent)
  ? (rawContent?.missionText || rawContent?.text || rawContent?.html || (typeof rawContent === 'string' ? rawContent : ''))
  : (legalData.missionText || legalData.html || legalData.htmlContent || '');
---

<BunzoLayout title={`${pageTitle} - ${siteConfig.name || ''}`} description={pageDesc}>
  <Breadcrumb slug={pageTitle} />

  <section class="py-section bg-white font-base">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="content prose prose-lg prose-primary max-w-none space-y-8">
        <h1 class="text-3xl md:text-4xl font-bold font-heading text-heading mb-6">{pageTitle}</h1>

        {sections.length > 0 && sections.map((section: any) => {
          const isHtml = typeof section.text === 'string' && /<[a-z][\s\S]*>/i.test(section.text);
          return (
            <div class="legal-section mb-6">
                {section.title && <h2 class="text-2xl font-bold mb-3">{section.title}</h2>}
                {isHtml ? (
                  <div class="text-gray-600 leading-relaxed space-y-4" set:html={section.text} />
                ) : (
                  <div class="text-gray-600 leading-relaxed whitespace-pre-line">{section.text}</div>
                )}
            </div>
          );
        })}

        {htmlContent && (
            <div class="text-gray-600 leading-relaxed space-y-4 font-normal" set:html={htmlContent} />
        )}
      </div>
    </div>
  </section>
</BunzoLayout>
